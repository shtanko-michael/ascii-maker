# Port of the local API server
PORT=8787

# Command used to generate music. JSON array, no shell involved.
# Placeholders: {prompt} {ms} {seconds} {out}
# Check the exact subcommand/flags of your installed CLI with:  elevenlabs music --help
MUSIC_CMD=["elevenlabs","music","compose","--prompt","{prompt}","--music-length-ms","{ms}","--output","{out}"]

# Optional fallback: if the CLI call fails and a key is set, the server calls the REST API directly.
ELEVENLABS_API_KEY=

# ffmpeg binary used to convert the recorded WebM to Instagram-ready MP4
FFMPEG=ffmpeg
