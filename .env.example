# Port of the local API server
PORT=8787

# ElevenLabs CLI command (JSON array, no shell). Placeholders: {json} {out} {ms} {prompt}
# CLI 1.12 rejects --prompt/--music-length-ms flags, so the body goes in via --json.
MUSIC_CMD=["elevenlabs","music","compose","--json","{json}","--output-format","mp3_44100_128","-o","{out}"]

# Optional: API key. Passed to the CLI as --xi-api-key and used for the REST fallback.
# Leave empty if you ran `elevenlabs auth login`.
ELEVENLABS_API_KEY=

# Claude Code CLI used to write the music prompt, caption and 5 hashtags.
CLAUDE_CMD=["claude","-p","{prompt}","--output-format","json","--allowedTools","Read"]

# ffmpeg binary used to convert the recorded WebM to an Instagram-ready MP4
FFMPEG=ffmpeg

# ---------------- Instagram publishing ----------------
# Recommended: ngrok with your free static domain (dashboard.ngrok.com → Domains).
# The server starts the tunnel itself and derives PUBLIC_BASE_URL and IG_REDIRECT_URI from it.
NGROK_DOMAIN=
# Only if you have not run `ngrok config add-authtoken ...`:
NGROK_AUTHTOKEN=
NGROK=ngrok

# Instagram must download the video from a public HTTPS URL.
# Either install cloudflared (a free quick tunnel is opened automatically while publishing)
# or set your own public address that proxies to this server:
PUBLIC_BASE_URL=
CLOUDFLARED=cloudflared

# Optional "Log in with Instagram" button (otherwise paste tokens from the Meta dashboard).
# Use the *Instagram* app ID and secret from the Instagram login setup page (they differ from the Facebook app ID).
# With NGROK_DOMAIN set, IG_REDIRECT_URI defaults to https://<NGROK_DOMAIN>/api/ig/callback; register it in the app.
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=
IG_API_VERSION=v23.0
